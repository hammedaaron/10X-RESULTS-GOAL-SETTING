rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGoal(data, userId) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.type is string && (data.type == 'goal' || data.type == 'battle_plan' || data.type == 'tenx_goal')
        && data.title is string && data.title.size() <= 300
        && (!('month' in data) || (data.month is string && data.month.size() <= 60))
        && (!('monthKey' in data) || (data.monthKey is string && data.monthKey.size() <= 20))
        && (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 60))
        && (!('contentHtml' in data) || (data.contentHtml is string && data.contentHtml.size() <= 1000000))
        && (!('plainText' in data) || (data.plainText is string && data.plainText.size() <= 1000000))
        && (!('deletedAt' in data) || data.deletedAt == null || (data.deletedAt is string && data.deletedAt.size() <= 50))
        && (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100))
        && (!('status' in data) || (data.status is string && (data.status == 'in_progress' || data.status == 'achieved' || data.status == 'needs_attention')))
        && (!('isMoonshot' in data) || (data.isMoonshot is bool))
        && (!('sessionsLog' in data) || (data.sessionsLog is list && data.sessionsLog.size() <= 500))
        && (!('battlePlanItems' in data) || (data.battlePlanItems is list && data.battlePlanItems.size() <= 200))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidSettings(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && data.theme is string && data.theme.size() <= 50
        && data.fontFamily is string && data.fontFamily.size() <= 50
        && data.fontSize is number && data.fontSize >= 10 && data.fontSize <= 40
        && data.consistencyDailyTarget is number && data.consistencyDailyTarget >= 1 && data.consistencyDailyTarget <= 10
        && data.autoSave is bool;
    }

    // User subcollection for goals and battle plans
    match /users/{userId}/goals/{goalId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(goalId)
        && isValidGoal(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidId(goalId)
        && isValidGoal(request.resource.data, userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId)
        && isValidId(goalId);
    }

    // User settings subcollection
    match /users/{userId}/settings/{settingId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(settingId)
        && isValidSettings(request.resource.data, userId);
      allow delete: if isOwner(userId)
        && isValidId(settingId);
    }
  }
}
